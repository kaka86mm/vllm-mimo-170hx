# 复制为 env.sh 后按机器修改；所有启动脚本自动 source 同目录 env.sh
# cp env.example env.sh

# 模型权重目录（download-weights.sh 的默认下载位置）
export MODEL_DIR=${MODEL_DIR:-$HOME/models/MiMo-V2.6-Flash-RL-NVFP4}

# 服务端口与容器名
export PORT=${PORT:-8099}
export CONTAINER=${CONTAINER:-mimo26}

# 镜像：daocloud 镜像源（国内）；海外直连可改 lazymio/vllm-backport:v0.13.0-sm80
export IMAGE=${IMAGE:-docker.m.daocloud.io/lazymio/vllm-backport:v0.13.0-sm80}

# 使用的 GPU（按 PCI 顺序）
export GPUS=${GPUS:-0,1,2,3}

# HuggingFace 下载源：国内用镜像，海外删掉这行走直连
export HF_ENDPOINT=${HF_ENDPOINT:-https://hf-mirror.com}

# hf CLI 所在 venv（需要 huggingface_hub；Python 3.14 装 hf_transfer 会失败，不用装）
export HFENV=${HFENV:-$HOME/hfenv}
